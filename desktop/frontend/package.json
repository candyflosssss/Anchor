{
  "name": "anchor-desktop-prototype",
  "version": "0.1.0-prototype.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.1",
    "npm": "9.2.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode prototype",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts *.js",
    "test": "vitest run",
    "test:ui": "playwright test --workers=1",
    "build": "tsc --noEmit && vite build --mode desktop",
    "test:desktop": "playwright test --config playwright.desktop.config.ts --workers=1"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.24",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
